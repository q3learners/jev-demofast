{
  // The hosted jev-demofast service: this Worker (the page, the API, sign-in) in front of the demo recorder container.
  // `npm run deploy` from here. Secrets: see README.md in this folder.
  "name": "jev-demofast-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Only the custom domain, behind Cloudflare Access: a workers.dev or preview URL would skip the sign-in.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.onecentdemo.com", "custom_domain": true }],

  // The page's files; the Worker runs first so every request is signed in.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "containers": [{
    "class_name": "Recorder",
    "image": "./container/Dockerfile",
    "image_build_context": "../..",
    // Screenshots are CPU-bound in headless Chrome: 4 vCPU, 12 GiB.
    "instance_type": "standard-4",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "RECORDER", "class_name": "Recorder" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Recorder"] }],

  // Finished demos (video, founder's script, narration), kept after the container sleeps.
  "r2_buckets": [{ "binding": "DEMOS", "bucket_name": "jev-demofast-demos" }],

  "vars": {
    "JDF_LLM_PROVIDER": "nebius",
    // Cloudflare Access (Zero Trust → Access → Applications): the team domain and the application's audience tag.
    "ACCESS_TEAM_DOMAIN": "vpodugu.cloudflareaccess.com",
    "ACCESS_AUD": "bba2d62a46d38d356570930499cbab02608fcc4d00650dce9bf4ccac4d525dd6"
  }
  // Secrets (wrangler secret put): CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, JEV_TOKEN, NEBIUS_API_KEY
}
